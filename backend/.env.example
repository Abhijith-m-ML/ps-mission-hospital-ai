# Project Settings
PROJECT_NAME="Hospital AI Assistant"
ENVIRONMENT="development"
API_V1_PREFIX="/api"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Origins (JSON list or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL="INFO"

# Document Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Embedding Configuration
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PREVIEW_DIMS=5

# Pinecone Vector Database Configuration
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="hospital-ai"
PINECONE_NAMESPACE="ps_mission_hospital"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
PINECONE_UPSERT_BATCH_SIZE=100

# Retrieval Layer Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_MAX_CONTEXT_CHUNKS=5
RETRIEVAL_MAX_CONTEXT_CHARACTERS=12000

# Hosted LLM API Configuration (openai or gemini)
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=800

